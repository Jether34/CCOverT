NODE_ENV=development
PORT=4000
# Comma-separated allowlist of browser origins allowed to call this API. Only
# enforced when NODE_ENV is not "development": in development every origin is
# accepted, so a stray port or hostname spelling cannot block local work.
# Outside development, anything not listed here is refused with 403.
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
APP_URL=http://localhost:5173
DOCKER_WEB_ORIGIN=http://localhost:8080
DOCKER_APP_URL=http://localhost:8080
MONGODB_URI=mongodb://localhost:27017/ccover_t
USE_MEMORY_DB=true
BACKUP_DIR=./backups
SESSION_SECRET=
COOKIE_SECURE=false
TRUST_PROXY=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
DEV_VERIFICATION_ENABLED=true
LOGIN_OTP_ENABLED=true
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_REQUIRED=false
VITE_RECAPTCHA_SITE_KEY=
MODEL_SERVICE_URL=http://localhost:8000
MODEL_MAX_FORECAST_HORIZON_YEARS=100
MODEL_MAX_FORECAST_YEAR=2100
# Shared secret the Express API sends as the x-service-token header. Required.
MODEL_SERVICE_TOKEN=
# Synthetic DEMO profile switches. Both are refused when NODE_ENV=production.
# MODEL_ALLOW_DEMO_PROFILE gates the model service, ALLOW_DEMO_PROFILE the API.
MODEL_ALLOW_DEMO_PROFILE=true
ALLOW_DEMO_PROFILE=true
# Port for the Mailpit development mailbox UI (Compose only).
MAILPIT_UI_PORT=8025
AI_PROVIDER=disabled
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
ENVIRONMENTAL_PROVIDER=disabled
ENVIRONMENTAL_PROVIDER_URL=
ENVIRONMENTAL_PROVIDER_API_KEY=
REEF_STATIONS_JSON=
UPLOAD_MAX_BYTES=5242880
DATA_RETENTION_DAYS=365
BOOTSTRAP_RESEARCHER_EMAILS=r@cctover.com
BOOTSTRAP_RESEARCHER_PASSWORD=replace-with-a-strong-secret
BOOTSTRAP_ADMIN_EMAILS=jether@cctover.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-secret
